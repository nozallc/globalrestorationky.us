---
/**
 * NOZA-managed HighLevel (LeadConnector) chat widget. Reusable on any page:
 *   <HighLevelChatWidget />
 *
 * Loading strategy (keeps it off the critical path):
 *  - nothing is fetched until the page has fully loaded, AND
 *  - the loader then starts on the first user interaction (scroll, touch, key, mouse)
 *    or after `delay` ms, whichever comes first.
 * A page-level guard prevents a second instance if the component is included twice.
 *
 * Optional mobile (< 768px) adjustments, all off by default. The widget renders in an open
 * shadow root, so CSS overrides are injected there once it exists:
 *  - mobileBottomOffset: CSS length (e.g. "5.25rem") that lifts the bubble above a fixed
 *    bottom bar such as the landing page's sticky call button.
 *  - hideGreetingOnMobile: hides the "Have a question?" greeting popup (bubble stays).
 *  - hideOnMobileWhileVisible: CSS selector; the whole widget is hidden while that element
 *    is on screen (used so the bubble never covers an embedded form).
 */
interface Props {
  widgetId?: string;
  delay?: number;
  mobileBottomOffset?: string;
  hideGreetingOnMobile?: boolean;
  hideOnMobileWhileVisible?: string;
}

const {
  widgetId = '69e99e40e6b8eef3b3a97f37',
  delay = 4000,
  mobileBottomOffset = '',
  hideGreetingOnMobile = false,
  hideOnMobileWhileVisible = '',
} = Astro.props;
---

<script is:inline define:vars={{ widgetId, delay, mobileBottomOffset, hideGreetingOnMobile, hideOnMobileWhileVisible }}>
  (function () {
    if (window.__ghlChatRequested) return;
    window.__ghlChatRequested = true;

    var MOBILE = '(max-width: 767px)';
    var EVENTS = ['scroll', 'touchstart', 'mousemove', 'keydown', 'pointerdown'];
    var started = false;

    function start() {
      if (started) return;
      started = true;
      EVENTS.forEach(function (t) { window.removeEventListener(t, start); });
      if (document.querySelector('script[data-widget-id="' + widgetId + '"]')) return;
      var s = document.createElement('script');
      s.src = 'https://widgets.leadconnectorhq.com/loader.js';
      s.setAttribute('data-resources-url', 'https://widgets.leadconnectorhq.com/chat-widget/loader.js');
      s.setAttribute('data-widget-id', widgetId);
      s.async = true;
      document.body.appendChild(s);
      if (mobileBottomOffset || hideGreetingOnMobile) injectMobileCss();
      if (hideOnMobileWhileVisible) hideWhileVisible();
    }

    function injectMobileCss() {
      var tries = 0;
      var timer = setInterval(function () {
        var host = document.querySelector('chat-widget');
        var root = host && host.shadowRoot;
        if (root && root.getElementById('lc_text-widget')) {
          clearInterval(timer);
          var css = '';
          if (mobileBottomOffset) css += '#lc_text-widget,#lc_text-widget--btn{bottom:calc(' + mobileBottomOffset + ' + env(safe-area-inset-bottom)) !important}';
          if (hideGreetingOnMobile) css += '.lc_text-widget--prompt{display:none !important}';
          var st = document.createElement('style');
          st.textContent = '@media ' + MOBILE + '{' + css + '}';
          root.appendChild(st);
        } else if (++tries > 100) {
          clearInterval(timer);
        }
      }, 200);
    }

    function hideWhileVisible() {
      var target = document.querySelector(hideOnMobileWhileVisible);
      if (!target || !('IntersectionObserver' in window)) return;
      var mq = window.matchMedia(MOBILE);
      var visible = false;
      function apply() {
        var host = document.querySelector('chat-widget');
        if (host) host.style.display = visible && mq.matches ? 'none' : '';
      }
      new IntersectionObserver(function (entries) {
        visible = entries[entries.length - 1].isIntersecting;
        apply();
      }).observe(target);
      if (mq.addEventListener) mq.addEventListener('change', apply);
      // The widget element appears after its loader runs; re-apply once it exists.
      var tries = 0;
      var timer = setInterval(function () {
        if (document.querySelector('chat-widget')) { clearInterval(timer); apply(); }
        else if (++tries > 100) clearInterval(timer);
      }, 200);
    }

    function arm() {
      EVENTS.forEach(function (t) { window.addEventListener(t, start, { once: true, passive: true }); });
      setTimeout(start, delay);
    }
    document.readyState === 'complete' ? arm() : window.addEventListener('load', arm);
  })();
</script>
