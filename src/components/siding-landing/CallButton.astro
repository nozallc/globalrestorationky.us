---
/**
 * Click-to-call link. Every call CTA on the landing page uses this component so the
 * number, tel: format, accessible name and tracking attribute stay consistent.
 * `placement` is reported with the GA4 `call_button_click` event.
 */
import { LANDING } from '../../lib/siding-landing';

interface Props {
  placement: string;
  variant?: 'solid' | 'outline' | 'light';
  showNumber?: boolean;
  class?: string;
}

const { placement, variant = 'solid', showNumber = true, class: extra = '' } = Astro.props;

const variants = {
  solid: 'bg-[#dc2626] text-white hover:bg-[#b91c1c] border-transparent',
  outline: 'bg-white text-global-blue border-global-blue hover:bg-slate-50',
  light: 'bg-white text-global-blue border-transparent hover:bg-slate-100',
};
---

<a
  href={LANDING.telHref}
  data-call-cta={placement}
  class:list={[
    'inline-flex min-h-[52px] items-center justify-center gap-2 whitespace-nowrap rounded-lg border-2 px-6 py-3 text-lg font-extrabold shadow-btn focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-amber-400',
    variants[variant],
    extra,
  ]}
>
  <svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
    <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z"/>
  </svg>
  <span>{showNumber ? `Call ${LANDING.phoneDisplay}` : "Call Global Restoration"}</span>
</a>
