---
/**
 * Siding landing page. Served at "/" on the temporary siding.noza.app build
 * (see scripts/build-siding.mjs); exists at /siding-landing in the full-site build,
 * where it is noindex so it cannot compete with /services/siding.
 */
import { Image, getImage } from 'astro:assets';
import SidingLandingLayout from '../layouts/SidingLandingLayout.astro';
import CallButton from '../components/siding-landing/CallButton.astro';
import CallStrip from '../components/siding-landing/CallStrip.astro';
import HighLevelChatWidget from '../components/HighLevelChatWidget.astro';
import { LANDING, IS_SIDING_BUILD, SERVICE_AREAS, FAQS } from '../lib/siding-landing';
import heroImage from '../assets/siding/siding-01.webp';

const title = 'Siding Installation & Replacement in Lexington, KY | Global Restoration LLC';
const description =
  'Residential siding installation, replacement and repair for Lexington and Central Kentucky homeowners. Call Global Restoration LLC or request a siding estimate.';

const canonical = `${LANDING.url}/`;
const og = await getImage({ src: heroImage, width: 1200, format: 'webp' });
const ogImage = new URL(og.src, LANDING.url).toString();

const formEnabled = LANDING.leadEndpoint !== '';

const business = {
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${LANDING.url}/#business`,
  name: LANDING.business,
  url: canonical,
  telephone: LANDING.schemaTel,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '616 W 3rd St',
    addressLocality: 'Lexington',
    addressRegion: 'KY',
    postalCode: '40508',
    addressCountry: 'US',
  },
  areaServed: SERVICE_AREAS.map((a) => ({
    '@type': 'AdministrativeArea',
    name: `${a.county} County, KY`,
  })),
};

const jsonLd = [
  { '@context': 'https://schema.org', ...business },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Residential siding installation, replacement and repair',
    serviceType: 'Siding installation',
    provider: { '@id': `${LANDING.url}/#business` },
    areaServed: business.areaServed,
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const services = [
  ['Siding installation', 'New siding for your home, including updating the exterior when you want a fresh look and better protection.'],
  ['Full siding replacement', 'Remove worn, damaged or outdated siding and replace it with new material across the whole home.'],
  ['Siding repair', 'Replace cracked, loose or damaged sections when repair makes more sense than replacing everything.'],
] as const;

const signs = [
  'Cracked, warped, buckled or loose panels',
  'Fading, chalking or peeling finish',
  'Gaps, holes or missing pieces',
  'Soft spots, rot or mold on or near the siding',
  'Drafts or uneven temperatures indoors',
  'Damage from hail, wind or falling limbs',
];

const materials = [
  ['Vinyl siding', 'A common, low-maintenance option available in many colors and profiles.'],
  ['Fiber cement (James Hardie)', 'A durable, paintable siding that holds up to Kentucky weather.'],
  ['Engineered wood (LP SmartSide)', 'A wood-look siding with a clean, traditional appearance.'],
] as const;

const steps = [
  ['Call or request an estimate', 'Tell us about your home and what you are seeing.'],
  ['We look at your siding', 'We check the condition of the siding and the wall behind it.'],
  ['Review your options', 'We go over materials and give you an estimate.'],
  ['Installation', 'Once you approve the work, we schedule and install your siding.'],
] as const;

const projectTypes = [
  'Full siding replacement',
  'New siding installation',
  'Siding repair',
  'Not sure yet',
];

const inputClass =
  'mt-1 block min-h-[48px] w-full rounded-lg border-2 border-slate-300 bg-white px-3 py-2 text-base text-slate-900 focus:border-global-blue focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-global-blue';
---

<SidingLandingLayout
  title={title}
  description={description}
  canonical={canonical}
  indexable={IS_SIDING_BUILD}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <!-- 1. Hero -->
  <section class="bg-global-blue text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-6 px-4 py-8 md:grid-cols-2 md:gap-10 md:py-14">
      <div>
        <p class="text-sm font-bold uppercase tracking-wide text-amber-300">Lexington &amp; Central Kentucky</p>
        <h1 class="mt-2 text-3xl font-black leading-tight sm:text-4xl lg:text-5xl">
          Professional Siding Installation &amp; Replacement in Lexington, KY
        </h1>
        <p class="mt-4 text-lg text-white/90">
          Global Restoration LLC installs, replaces and repairs siding for local homeowners, improving how your home looks and how well it is protected. Call for a convenient estimate.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <CallButton placement="hero" variant="solid" showNumber={false} class="sm:w-auto" />
          <a
            href="#estimate"
            class="inline-flex min-h-[52px] items-center justify-center rounded-lg border-2 border-white px-6 py-3 text-lg font-bold text-white hover:bg-white/10 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-amber-400"
          >
            Request a Siding Estimate
          </a>
        </div>
        <ul class="mt-6 space-y-1 text-sm font-semibold text-white/90">
          <li>&#10003; Locally owned in Lexington, KY</li>
          <li>&#10003; Serving Lexington and 7 surrounding counties</li>
          <li>&#10003; Residential siding installation, replacement &amp; repair</li>
        </ul>
      </div>
      <!-- LCP image: real <img> in the initial HTML, eager, high priority, explicit dimensions. -->
      <Image
        src={heroImage}
        alt="Global Restoration crew member installing new siding on a Kentucky home"
        widths={[480, 768, 1080, 1536]}
        sizes="(min-width: 768px) 560px, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[4/3] w-full rounded-2xl object-cover object-top shadow-xl md:aspect-[4/5]"
      />
    </div>
  </section>

  <!-- 2. Services -->
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="text-center text-2xl font-black text-global-blue sm:text-3xl">Siding Installation, Replacement &amp; Repair</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {services.map(([name, desc]) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
          <h3 class="text-xl font-extrabold text-slate-900">{name}</h3>
          <p class="mt-2 text-base text-slate-700">{desc}</p>
        </div>
      ))}
    </div>
    <CallStrip placement="after-services" text="Ready to talk about your siding?" />
  </section>

  <!-- 3. Signs -->
  <section class="bg-brand-neutral px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-center text-2xl font-black text-global-blue sm:text-3xl">Signs You May Need New Siding</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {signs.map((s) => (
          <li class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 text-base text-slate-800">
            <span aria-hidden="true" class="mt-0.5 font-black text-[#dc2626]">&#10003;</span>
            <span>{s}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. Repair vs replace -->
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h2 class="text-center text-2xl font-black text-global-blue sm:text-3xl">Repair or Replace?</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 p-6">
        <h3 class="text-xl font-extrabold text-slate-900">Repair may be enough when</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-base text-slate-700">
          <li>Damage is limited to a few panels or one area</li>
          <li>Matching siding is still available</li>
          <li>The wall behind the siding is dry and sound</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-slate-200 p-6">
        <h3 class="text-xl font-extrabold text-slate-900">Replacement usually makes sense when</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-base text-slate-700">
          <li>Damage or wear is widespread</li>
          <li>You keep paying for repeat repairs</li>
          <li>There are moisture, rot or mold problems</li>
          <li>Repairs would not match the rest of the house</li>
        </ul>
      </div>
    </div>
    <p class="mt-6 text-center text-base text-slate-700">Not sure which applies? We will take a look and tell you.</p>
    <CallStrip placement="after-repair-replace" text="Get an honest recommendation for your home." />
  </section>

  <!-- 5. Materials -->
  <section class="bg-brand-neutral px-4 py-12">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-2xl font-black text-global-blue sm:text-3xl">Siding Materials We Install</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {materials.map(([name, desc]) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
            <h3 class="text-xl font-extrabold text-slate-900">{name}</h3>
            <p class="mt-2 text-base text-slate-700">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Process -->
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h2 class="text-center text-2xl font-black text-global-blue sm:text-3xl">How It Works</h2>
    <ol class="mt-8 space-y-4">
      {steps.map(([name, desc], i) => (
        <li class="flex items-start gap-4 rounded-xl border border-slate-200 p-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-global-blue text-lg font-black text-white" aria-hidden="true">{i + 1}</span>
          <div>
            <h3 class="text-lg font-extrabold text-slate-900">{name}</h3>
            <p class="text-base text-slate-700">{desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- 7. Service area -->
  <section class="bg-brand-neutral px-4 py-12">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-2xl font-black text-global-blue sm:text-3xl">Serving Lexington &amp; Central Kentucky</h2>
      <ul class="mt-6 flex flex-wrap justify-center gap-2">
        {SERVICE_AREAS.map((a) => (
          <li class="rounded-full border border-slate-300 bg-white px-4 py-2 text-base font-semibold text-slate-800">
            {a.city} <span class="font-normal text-slate-600">({a.county} Co.)</span>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-base text-slate-700">Not sure we cover your address? Call and ask.</p>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h2 class="text-center text-2xl font-black text-global-blue sm:text-3xl">Siding Questions</h2>
    <div class="mt-8 space-y-3">
      {FAQS.map((f) => (
        <details class="group rounded-xl border border-slate-200 bg-white p-4">
          <summary class="flex min-h-[44px] cursor-pointer items-center justify-between gap-3 text-lg font-bold text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-global-blue">
            {f.q}
            <span aria-hidden="true" class="text-2xl font-black text-global-blue group-open:rotate-45">+</span>
          </summary>
          <p class="mt-2 text-base text-slate-700">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- 9. Final CTA + form -->
  <section id="estimate" class="scroll-mt-4 bg-global-blue px-4 py-12 text-white">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-center text-2xl font-black sm:text-3xl">Get Your Siding Estimate</h2>
      <p class="mt-2 text-center text-lg text-white/90">The fastest way to reach us is by phone.</p>
      <div class="mt-5 flex justify-center">
        <CallButton placement="final-cta" variant="solid" />
      </div>

      {formEnabled ? (
        <div class="mt-8 rounded-2xl bg-white p-5 text-slate-900 sm:p-7">
          <h3 class="text-xl font-extrabold text-global-blue">Or request an estimate online</h3>
          <form id="estimate-form" class="mt-4 space-y-4" method="post" novalidate data-endpoint={LANDING.leadEndpoint}>
            <div>
              <label for="f-name" class="block font-semibold">Full name</label>
              <input id="f-name" name="full_name" type="text" autocomplete="name" required maxlength="100" class={inputClass} />
            </div>
            <div>
              <label for="f-phone" class="block font-semibold">Phone number</label>
              <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="25" class={inputClass} />
            </div>
            <div>
              <label for="f-city" class="block font-semibold">City or ZIP code</label>
              <input id="f-city" name="city_or_zip" type="text" autocomplete="postal-code" required maxlength="60" class={inputClass} />
            </div>
            <div>
              <label for="f-type" class="block font-semibold">Type of siding project</label>
              <select id="f-type" name="project_type" required class={inputClass}>
                <option value="">Select one…</option>
                {projectTypes.map((p) => <option value={p}>{p}</option>)}
              </select>
            </div>
            <div>
              <label for="f-details" class="block font-semibold">Details <span class="font-normal text-slate-600">(optional)</span></label>
              <textarea id="f-details" name="message" rows="3" maxlength="1000" class={inputClass}></textarea>
            </div>
            <!-- Honeypot: hidden from people and assistive tech; bots fill it. -->
            <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
              <label for="f-website">Leave this field empty</label>
              <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <p class="text-sm text-slate-600">By submitting, you agree that {LANDING.business} may contact you about your estimate request.</p>
            <button type="submit" class="inline-flex min-h-[52px] w-full items-center justify-center rounded-lg bg-[#dc2626] px-6 py-3 text-lg font-extrabold text-white hover:bg-[#b91c1c] disabled:opacity-60 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-amber-400">
              Request My Siding Estimate
            </button>
            <div id="form-status" role="status" aria-live="polite" class="text-base font-semibold"></div>
          </form>
        </div>
      ) : (
        <p class="mt-8 rounded-xl bg-white/10 p-4 text-center text-base">
          To request a siding estimate, call us at <a href={LANDING.telHref} data-call-cta="final-cta-text" class="font-extrabold underline">{LANDING.phoneDisplay}</a>.
        </p>
      )}
    </div>
  </section>

  {formEnabled && (
    <script is:inline define:vars={{ tel: LANDING.telHref, display: LANDING.phoneDisplay, adsFormLabel: LANDING.adsFormLabel }}>
      (function () {
        var form = document.getElementById('estimate-form');
        if (!form) return;
        var status = document.getElementById('form-status');
        var button = form.querySelector('button[type="submit"]');
        var sent = false;
        var phoneLink = '<a class="underline" href="' + tel + '">' + display + '</a>';

        function say(html, ok) {
          status.innerHTML = html;
          status.style.color = ok ? '#047857' : '#b91c1c';
        }

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (sent) return;
          var f = form.elements;
          var phoneDigits = f.phone.value.replace(/\D/g, '');
          if (!f.full_name.value.trim() || phoneDigits.length < 10 || !f.city_or_zip.value.trim() || !f.project_type.value) {
            say('Please enter your name, a 10-digit phone number, your city or ZIP, and the project type.', false);
            return;
          }
          // Spam: a filled honeypot means a bot. Show success but send nothing.
          if (f.website.value) {
            say('Thanks! We received your request.', true);
            sent = true;
            return;
          }

          var attr = window.grAttribution ? window.grAttribution() : {};
          var payload = {
            full_name: f.full_name.value.trim(),
            phone: f.phone.value.trim(),
            city_or_zip: f.city_or_zip.value.trim(),
            project_type: f.project_type.value,
            message: f.message.value.trim(),
            lead_source: 'siding-landing',
            page_url: location.origin + location.pathname,
            submitted_at: new Date().toISOString()
          };
          Object.keys(attr).forEach(function (k) { payload[k] = attr[k]; });

          button.disabled = true;
          say('Sending…', true);
          var ctrl = new AbortController();
          var timer = setTimeout(function () { ctrl.abort(); }, 12000);

          fetch(form.getAttribute('data-endpoint'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            signal: ctrl.signal
          }).then(function (res) {
            clearTimeout(timer);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            sent = true;
            say('Thank you! We received your request and will contact you soon.', true);
            form.reset();
            if (window.grTrack) window.grTrack('generate_lead', { form_id: 'siding-estimate' }, adsFormLabel);
          }).catch(function () {
            clearTimeout(timer);
            button.disabled = false;
            say('Sorry, we could not send your request. Please try again or call us at ' + phoneLink + '.', false);
          });
        });
      })();
    </script>
  )}
  <HighLevelChatWidget mobileBottomOffset="5.25rem" />
</SidingLandingLayout>
