# Environment variables for the siding landing page build (npm run build:siding).
# Set these in Cloudflare Pages -> Settings -> Environment variables. Never commit real values.
# All are optional; the build works without them. The lead form is the HighLevel embed
# (src/components/HighLevelForm.astro) and needs no environment variable.

# Public origin of the landing page (canonical, og:url, sitemap, structured data).
# Defaults to https://siding.noza.app
PUBLIC_LANDING_URL=https://siding.noza.app

# Dedicated call-tracking number (HighLevel). Defaults to the existing company number.
PUBLIC_LANDING_PHONE=

# Analytics. GA4 defaults to the central ID in src/lib/analytics.ts (G-XV1EPBV6MX);
# set PUBLIC_LANDING_GA4_ID only to override it.
PUBLIC_LANDING_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_CALL_LABEL=
